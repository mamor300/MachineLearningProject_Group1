# Set cp = 0 to grow full trees (unpruned) as in standard Random Forest
trip.rpart[[i]] <- rpart(as.formula(formula_str), data = boot_sample, cp = 0.002)
rpart.plot(trip.rpart[[50]],)
# Train individual rpart tree
# Set cp = 0 to grow full trees (unpruned) as in standard Random Forest
trip.rpart[[i]] <- rpart(as.formula(formula_str), data = boot_sample, cp = 0.001)
# 2. Build the forest
for (i in 1:n_trees) {
# Bootstrap sample: random rows with replacement
boot_indices <- sample(1:nrow(trip), replace = TRUE)
boot_sample <- trip[boot_indices, ]
# Feature sampling: select a subset of predictors for this tree
# Randomly pick sqrt(total_features) for classification
features <- names(trip)[-1]
sampled_features <- sample(features, floor(sqrt(length(features))))
formula_str <- paste("Uber ~", paste(sampled_features, collapse = "+"))
# Train individual rpart tree
# Set cp = 0 to grow full trees (unpruned) as in standard Random Forest
trip.rpart[[i]] <- rpart(as.formula(formula_str), data = boot_sample, cp = 0.002)
}
View(trip)
