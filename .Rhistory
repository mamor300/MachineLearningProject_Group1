verboseIter = TRUE # Show training progress
)
ridgeGrid <- expand.grid(alpha = 0,
lambda = 10^seq(-3, 1, length = 100)) # A range of lambda values
logit.ridge <- train(Uber~. ,
data=trip.train,
method = 'glmnet',
tuneGrid = ridgeGrid,
trControl = fitControl,
family = 'binomial',
preProcess = c("center", "scale"))
# Confusion matrix based on CV
confusionMatrix(logit.ridge)
opt.ridge <- logit.ridge$bestTune$lambda
final.ridge <- logit.ridge$finalModel
Coef.ridge <- predict(final.ridge,type = "coefficients", s=opt.ridge)
coef_df.ridge <- as.data.frame(as.matrix(Coef.ridge))
print(logit.ridge)
plot(logit.ridge)
