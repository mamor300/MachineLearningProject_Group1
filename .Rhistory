rpart.plot(trip.rpart[[40]],)
rpart.plot(trip.rpart[[42]],)
rpart.plot(trip.rpart[[35]],)
rpart.plot(trip.rpart[[24]],)
rpart.plot(trip.rpart[[20]],)
rpart.plot(trip.rpart[[99]],)
rpart.plot(trip.rpart[[95]],)
