?glm
CFPB.lm <- glm(Relief~., data=CFPB, family= gaussian)
CFPB.rf <- readRDS("CFPB_rf.rds")
CFPB.rf <- readRDS("RandomForest/CFPB_rf.rds")
summary(CFPB.rf$finalModel)
(CFPB.rf$finalModel)
CFPB.test <- readRDS("CFPB_test.rds")
CFPB.pred <- factor(CFPB.pred, levels = "0","1")
CFPB.pred <- factor(CFPB.rf, levels = "0","1")
CFPB.pred <- predict(CFPB.rf, newdata = CFPB.test)
confusionMatrix(CFPB.pred,reference = CFPB.test$Relief, mode = "everything")
CFPB.lm <- glm(Relief~., data=CFPB, family= gaussian)
CFPB <- readRDS("CFPB.rds")|>
mutate(Relief = as.numeric(as.character(Relief)))
CFPB.lm <- glm(Relief~., data=CFPB, family= gaussian)
plot(CFPB.lm, which = 1)
plot(CFPB.lm,which = 2)
plot(CFPB.lm,which = 3)
plot(CFPB.lm,which = 5)
View(CFPB)
CFPB <- readRDS("CFPB.rds")[-1,]|>
mutate(Relief = as.numeric(as.character(Relief)))
CFPB.lm <- glm(Relief~., data=CFPB, family= gaussian)
plot(CFPB.lm,which = 5)
summary(CFPB.lm)
CFPB.pred <- predict(CFPB.lm, newdata = CFPB.test)
confusionMatrix(CFPB.pred,reference = CFPB.test$Relief, mode = "everything")
CFPB.testlm <- CFPB.test|>
mutate(Relief = as.numeric(as.character(Relief)))
CFPB.pred <- predict(CFPB.lm, newdata = CFPB.test)
confusionMatrix(CFPB.pred,reference = CFPB.test$Relief, mode = "everything")
?confusionMatrix
?predict
CFPB.pred <- predict(CFPB.lm, newdata = CFPB.testlm)
confusionMatrix(CFPB.pred,reference = CFPB.testlm$Relief, mode = "everything")
CFPB.pred <- ifelse(predict(CFPB.lm, newdata = CFPB.test)>.5,1,0)
confusionMatrix(CFPB.pred,reference = CFPB.test$Relief, mode = "everything")
CFPB.pred <- as.factor(ifelse(predict(CFPB.lm, newdata = CFPB.test)>.5,1,0))
confusionMatrix(CFPB.pred,reference = CFPB.test$Relief, mode = "everything")
CFPB.pred <- as.factor(ifelse(predict(CFPB.lm, newdata = CFPB.test)>.73,1,0))
