#### Visualizing with all variables ####   

library(ggplot2)

# 1. Extract the summary matrix
s <- summary(logit_model)
results <- as.data.frame(s$mat)
results$Variable <- rownames(results)

# 2. Calculate Odds Ratios and 95% Confidence Intervals
results$OR <- exp(results$Coef)
results$Lower <- exp(results$Coef - 1.96 * results$SE)
results$Upper <- exp(results$Coef + 1.96 * results$SE)

# 3. Filter for the most interesting variables (Companies and Methods)
# We exclude Intercept and State variables for clarity
plot_data <- results[!grepl("Intercept|State", results$Variable), ]

# 4. Create the Forest Plot
ggplot(plot_data, aes(x = reorder(Variable, OR), y = OR)) +
  geom_hline(yintercept = 1, linetype = "dashed", color = "red") +
  geom_pointrange(aes(ymin = Lower, ymax = Upper), color = "steelblue") +
  coord_flip() +  # Flip to make variable names readable
  scale_y_log10() + # Use log scale because Odds Ratios are multiplicative
  labs(
    title = "Predictors of Consumer Relief (Logit Model)",
    subtitle = "Odds Ratios > 1 indicate higher likelihood of relief",
    x = "Variable",
    y = "Odds Ratio (Log Scale)"
  ) +
  theme_minimal()  


#### Visualizing with only signficiant variables ####

# 1. Extract the summary matrix and p-values
s <- summary(logit_model)
results <- as.data.frame(s$mat)
results$Variable <- rownames(results)

# 2. Calculate Odds Ratios and 95% CIs
results$OR <- exp(results$Coef)
results$Lower <- exp(results$Coef - 1.96 * results$SE)
results$Upper <- exp(results$Coef + 1.96 * results$SE)

# 3. Rename p-value column for easier filtering (it's often the 4th column)
colnames(results)[4] <- "p_val"

# 4. Filter for significance (p < 0.05) and exclude the Intercept
significant_data <- results[results$p_val < 0.05 & results$Variable != "(Intercept)", ]

# 5. Create the "Significant Only" Forest Plot
ggplot(significant_data, aes(x = reorder(Variable, OR), y = OR)) +
  geom_hline(yintercept = 1, linetype = "dashed", color = "red") +
  geom_pointrange(aes(ymin = Lower, ymax = Upper), color = "darkgreen", size = 0.8) +
  coord_flip() + 
  scale_y_log10() +
  labs(
    title = "Statistically Significant Predictors of Relief",
    subtitle = "Only variables with p < 0.05 | Odds Ratios on Log Scale",
    x = "Predictor",
    y = "Odds Ratio"
  ) +
  theme_minimal() +
  theme(axis.text.y = element_text(size = 9)) 

